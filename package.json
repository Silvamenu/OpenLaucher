{
  "name": "recomphub",
  "productName": "RecompHub",
  "version": "0.1.0",
  "description": "Launcher unificado para ports e recompilações de jogos feitas por fãs.",
  "author": {
    "name": "RecompHub contributors"
  },
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/Silvamenu/OpenLaucher",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/generate-icon.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "dist": "npm run build && node scripts/release-notes.mjs && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && node scripts/release-notes.mjs && electron-builder --linux --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && node scripts/release-notes.mjs && electron-builder --win --x64 --publish always",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "picomatch": "^4.0.7",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
