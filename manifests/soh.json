          {
            "sha1": "cfecfdc58d650e71a200c81f033de4e6d617a9f6",
            "label": "PAL MQ (Debug)"
          },
          {
            "sha1": "ad69c91157f6705e8ab06c79fe08aad47bb57ba7",
            "label": "NTSC 1.0 (US)"
