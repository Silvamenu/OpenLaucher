          },
          {
            "sha1": "41b3bdc48d98c48529219919015a1af22f5057c2",
            "label": "NTSC 1.2 (US)"
          },
          {
            "sha1": "c892bbda3993e66bd0d56a10ecd30b1ee612210f",
            "label": "NTSC 1.0 (JP)"
          },
          {
            "sha1": "dbfc81f655187dc6fefd93fa6798face770d579d",
            "label": "NTSC 1.1 (JP)"
