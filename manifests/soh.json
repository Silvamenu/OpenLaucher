{
  "id": "soh",
  "name": "Ship of Harkinian",
  "originalGame": "The Legend of Zelda: Ocarina of Time",
  "description": "Port para PC de Ocarina of Time baseado na decompilação do jogo, com melhorias, randomizer e suporte a mods.",
  "repoUrl": "https://github.com/HarbourMasters/Shipwright",
  "website": "https://www.shipofharkinian.com",
  "accentColor": "#3f8f4a",
  "executables": {
    "win32": [
      "soh.exe"
    ],
    "linux": [
      "soh.appimage"
    ]
  },
  "detectFiles": [
    "soh.exe",
    "soh.appimage",
    "soh.o2r",
    "soh.otr"
  ],
  "requirements": [
    {
      "id": "port-data",
      "type": "file",
      "label": "Arquivo de dados do port (soh.o2r)",
      "patterns": [
        "soh.o2r",
        "soh.otr"
      ],
      "helpText": "Vem junto com o download oficial do port. Se estiver faltando, reinstale ou atualize o jogo."
    },
    {
      "id": "rom",
      "type": "userFile",
      "label": "Sua ROM de Ocarina of Time",
      "optional": true,
      "extensions": [
        "z64",
        "n64",
        "v64"
      ],
      "validation": {
        "sha1": [
          {
            "sha1": "328a1f1beba30ce5e178f031662019eb32c5f3b5",
